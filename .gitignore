*-test-droid/
/tasks/

# Aurora runtime data
.aurora/

# Project-local runtime data (all 4 packages)
.claude/
.factory/
.opencode/
.amp/
# `/tests/` (not `/tests/*`) would prune traversal into the directory entirely, and git
# cannot re-include a path whose parent directory is itself excluded — so this is written as
# "ignore every direct child" instead, which still lets the negation below re-admit one.
/tests/*
# Narrow re-admit: the docs-builder suite must be trackable, or it rots outside version
# control exactly like the suite it replaced (see tests/docs-builder/docs-builder.test.js).
!/tests/docs-builder/
!/tests/docs-builder/docs-builder.test.js
!/tests/friction/
!/tests/friction/friction.test.js
!/tests/version-check/
!/tests/version-check/version-check.test.js
!/tests/sync-rules/
!/tests/sync-rules/sync-rules.test.js
!/tests/stub-check/
!/tests/stub-check/stub-check.test.js
!/tests/installer/
!/tests/installer/closing-note.test.js
!/tests/mirror/
!/tests/mirror/mirror.test.js

# Release artifacts
liteagents-*.tgz

# Local test reports (ephemeral output from local test runs)
TEST_REPORT.md
test-report.json
validation-results.json

# Local browser-automation scratch (barebrowse mcp)
.barebrowse/

# Local litectx MCP index
.litectx/

# Agent / IDE / tooling scratch — ignore EVERY dot-directory by default
# (.claude, .litectx, .idea, .barebrowse, .vscode, and whatever the next tool
# invents), then re-admit only the ones we actually ship. Default-deny beats
# chasing each new scratch dir with its own line.
.*/
!.github/

# docs-builder machine state — regenerated every run; ledger stamp is per-clone
/docs/.docs-builder/
