{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
      "1-create-prd": {
      "prompt": "{file:./agent/1-create-prd.md}",
      "mode": "subagent",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      },
      "description": "Creates a PRD through structured discovery. Use when defining scope, to outline what needs to be built. Not for task lists, epics, architecture, UI design, market research or code."
    },
        "2-generate-tasks": {
      "prompt": "{file:./agent/2-generate-tasks.md}",
      "mode": "subagent",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      },
      "description": "Converts a PRD into a granular, actionable development task list. Use for detailed planning of a PRD. Not for writing the PRD, designing the system or writing code."
    },
        "3-process-task-list": {
      "prompt": "{file:./agent/3-process-task-list.md}",
      "mode": "subagent",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      },
      "description": "Executes a task list one task at a time with sequential commits, pausing for review. Use for iterative implementation of an existing list. Not for writing the list or free-form coding."
    },
    "ui-designer": {
      "prompt": "{file:./agent/ui-designer.md}",
      "mode": "subagent",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      },
      "description": "Designs lightweight, functional UI with simplified flows. Use for UI/UX design, user journeys, low-fidelity mockups, flow simplification and framework selection. Not for building the UI, system design, PRDs or review."
    },
    "quality-assurance": {
      "prompt": "{file:./agent/quality-assurance.md}",
      "mode": "subagent",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      },
      "description": "Reviews code quality, test architecture and coverage, and makes quality gate calls. Use for code review and improvement recommendations. Not for fixing code or the full pre-merge review and security audit."
    },
    "feature-planner": {
      "prompt": "{file:./agent/feature-planner.md}",
      "mode": "subagent",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      },
      "description": "Creates epics and user stories, prioritizes and manages the backlog. Use for story refinement, prioritization and backlog navigation. Not for the PRD, task lists, architecture, UI, research or code."
    },
    "code-developer": {
      "prompt": "{file:./agent/code-developer.md}",
      "mode": "subagent",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      },
      "description": "Implements code, debugs, refactors and optimizes. Use for code implementation, debugging, refactoring and development best practices. Not for architecture, product scope or UI design."
    },
    "system-architect": {
      "prompt": "{file:./agent/system-architect.md}",
      "mode": "subagent",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      },
      "description": "Designs MVP-first architectures with a preference for open source. Use for system design, HLA/HLD, technology selection and architecture validation from epics, stories or PRDs. Not for code, scope, tasks, UI or review."
      },
    "market-researcher": {
      "prompt": "{file:./agent/market-researcher.md}",
      "mode": "subagent",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      },
      "description": "Researches markets, analyzes competitors and writes project briefs. Use for market research, competitive analysis and initial project discovery. Not for code, PRDs, tasks, stories, architecture, UI or review."
    }
  },
  "command": {
    "root-cause": {
      "template": "{file:./command/root-cause.md}",
      "description": "Find the cause before changing code - evidence, backward trace, one hypothesis, fix at the source"
    },
    "brainstorming": {
      "template": "{file:./command/brainstorming.md}",
      "description": "Facilitate structured brainstorming sessions with proven techniques and frameworks"
    },
    "docs-builder": {
      "template": "{file:./command/docs-builder.md}",
      "description": "Reorg a docs corpus, split an oversized doc, keep pages current, index them"
    },
    "self-review": {
      "template": "{file:./command/self-review.md}",
      "description": "Verify what you delivered since the last self-review with real runs, and review its structure"
    },
    "live-canvas": {
      "template": "{file:./command/live-canvas.md}",
      "description": "Design UI variations and collect click-to-annotate feedback from the browser (batch mode only on Opencode)"
    },
    "refactor": {
      "template": "{file:./command/refactor.md}",
      "description": "Refactor and optimize code while maintaining behavior and tests"
    },
    "branch-review": {
      "template": "{file:./command/branch-review.md}",
      "description": "Pre-merge review: general review + full security audit, verify pass, docs sweep; no code fixes"
    },
    "security": {
      "template": "{file:./command/security.md}",
      "description": "Security audit — recurring six, injection, auth, trust boundaries; reports, never fixes"
    },
    "release": {
      "template": "{file:./command/release.md}",
      "description": "Verify, write the CHANGELOG, cut a version — then hand back the merge/tag/publish sequence"
    },
    "remember": {
      "template": "{file:./command/remember.md}",
      "description": "Consolidate stashes + friction into project memory"
    },
    "stash": {
      "template": "{file:./command/stash.md}",
      "description": "Save session context for compaction recovery or handoffs"
    },
    "test-generate": {
      "template": "{file:./command/test-generate.md}",
      "description": "Generate tests, run them, and verify each test actually exercises the code (not just passes)"
    }
  }
}
